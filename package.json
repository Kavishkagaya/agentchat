{
  "name": "axon",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter @axon/web dev",
    "dev:orchestrator": "pnpm --filter @axon/orchestrator dev",
    "dev:agents": "pnpm --filter @axon/agents dev",
    "dev:memory-controller": "pnpm --filter @axon/memory-controller dev",
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "fix": "ultracite fix",
    "check": "biome check . --write",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@cloudflare/workers-types": "^4.20260307.1",
    "@types/node": "22.7.5",
    "ultracite": "^7.2.3",
    "wrangler": "^4.71.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
